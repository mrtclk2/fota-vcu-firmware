# Secure Gateway icin gerekli sdkconfig sapmalari.
# sdkconfig dosyasinin kendisi git'e eklenmez (yerel toolchain yollarini
# icerir); idf.py set-target/build sirasinda bu dosya otomatik uygulanir.

# NimBLE (BLE GATT sunucusu) - ble_handler.c bu olmadan derlenmez
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# esp_http_server WebSocket destegi - gateway_web_server.c bu olmadan derlenmez
CONFIG_HTTPD_WS_SUPPORT=y

# OTA icin cift app partisyon tablosu (partitions.csv: ota_0 + ota_1)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash boyutu (partitions.csv toplami ~3.2MB, kart 4MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
